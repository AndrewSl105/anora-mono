# /srv/fleetpocket/.env — server configuration. Copy from deploy/.env.example.
# Values containing `$` (the bcrypt hash) must be in single quotes.

# ---- Domain ----
# Public host name; Caddy serves it with an automatic Let's Encrypt certificate.
FLEETPOCKET_DOMAIN=fleetpocket.example.com

# ---- HTTP ----
# Listen address inside the container.
HTTP_ADDR=:8080
# Public URL of this deployment; used in links (PR bodies, Telegram) when WEB_APP_URL is unset.
PUBLIC_BASE_URL=https://fleetpocket.example.com
# URL of the separate web client / Telegram Mini App (task links go to $WEB_APP_URL/tasks/<id>).
WEB_APP_URL=https://fleetpocket.example.com
# Only if the web client is served from another origin (comma-separated). Same-origin needs nothing.
CORS_ORIGINS=
# Local http development only: drop the Secure flag from the session cookie.
COOKIE_INSECURE=false

# ---- Database ----
# Password of the postgres service; the compose file builds DATABASE_URL from it.
PG_PASSWORD=change-me
# Set by docker-compose.deploy.yml; only set it yourself when running elsewhere.
# DATABASE_URL=postgres://fleetpocket:change-me@postgres:5432/fleetpocket?sslmode=disable

# ---- Docker and runners ----
# Docker API (the filtered socket proxy). Set by the compose file.
# DOCKER_HOST=tcp://docker-proxy:2375
# Host path of task workspaces; must be the same inside the container and owned by uid 1000.
WORKSPACES_DIR=/srv/fleetpocket/workspaces
# Host path of images attached to tasks (one folder per task, mounted read-only
# into the task's agent at /attachments). Same rules as WORKSPACES_DIR; must not
# be inside it.
ATTACHMENTS_DIR=/srv/fleetpocket/attachments
# Agent image; must already be pulled on the host (the server never pulls it).
RUNNER_IMAGE=ghcr.io/andrewsl105/fleetpocket-agent:latest
# Tasks that may hold a slot (preparing, running, waiting for input, pushing) at once.
MAX_CONCURRENT_TASKS=2
# Hard limits per runner container.
RUNNER_MEMORY=3g
RUNNER_CPUS=2
# uid:gid of runner containers; keep 1000:1000 (shared workspace ownership with Fleetpocket Runner).
RUNNER_USER=1000:1000
# Memory limit per sidecar (postgres, redis).
SIDECAR_MEMORY=512m
# Sidecars of tasks idle in paused/pr_open longer than this are removed.
SIDECAR_IDLE_TTL=30m
# Start runners in scripted fake mode (tests / local development without Claude).
FLEETPOCKET_RUNNER_FAKE=false

# ---- Claude ----
# Subscription token from `claude setup-token` (preferred) ...
CLAUDE_CODE_OAUTH_TOKEN=
# ... or an API key. Only runner containers receive these.
ANTHROPIC_API_KEY=
# Defaults for every project (a project can override each).
# Model id; empty = the SDK default.
DEFAULT_MODEL=
DEFAULT_MAX_TURNS=150
DEFAULT_MAX_BUDGET_USD=5
DEFAULT_MAX_DURATION=2h
# A question unanswered for this long pauses the task (containers stop; answering resumes it).
QUESTION_TIMEOUT=20m

# ---- GitHub App ----
# App ID from the App's settings page. Leave empty to run without GitHub (commits stay local).
GITHUB_APP_ID=
# Path of the App private key inside the container; the compose file mounts it here.
GITHUB_APP_PRIVATE_KEY_PATH=/secrets/github-app.pem
# Webhook secret configured on the App (required with GITHUB_APP_ID).
GITHUB_WEBHOOK_SECRET=
# Secrets scan before every push: gitleaks (default) or off (development only).
SECRETS_SCAN=gitleaks

# ---- Telegram ----
# Bot token from @BotFather. Leave empty to disable the bot.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id; the bot ignores everyone else.
TELEGRAM_ALLOWED_USER_ID=
# Optional t.me/<bot>/<app> link of the Mini App, for deep links from group topics.
TELEGRAM_MINIAPP_LINK=
# Voice/audio transcription: off, openai, or whispercpp.
STT_PROVIDER=off
# Required when STT_PROVIDER=openai. This is separate from the agent's Anthropic key.
OPENAI_API_KEY=
# Base URL of an optional whisper.cpp whisper-server sidecar.
WHISPERCPP_URL=http://whispercpp:8080

# ---- Owner login ----
# bcrypt hash from `fleetpocket hash-password` (single-quote it).
ADMIN_PASSWORD_HASH='$2a$12$replace.me'
# Base32 TOTP secret from `fleetpocket totp-setup`.
ADMIN_TOTP_SECRET=
# Random secret that signs session cookies: openssl rand -hex 32
SESSION_SECRET=

# ---- Retention ----
# Runner events of finished tasks older than this are deleted (status/PR/CI events stay).
EVENT_RETENTION=720h
# Workspaces and Claude state volumes are deleted this long after a task finishes.
WORKSPACE_RETENTION=168h

# ---- Deploy ----
# Image tags to run (the release workflow pulls :latest).
SERVER_TAG=latest
WEB_TAG=latest

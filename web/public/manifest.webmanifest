{
  "name": "Fleetpocket",
  "short_name": "Fleetpocket",
  "description": "Your fleet of coding agents: tasks on the server and on your own computers.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#ffffff",
